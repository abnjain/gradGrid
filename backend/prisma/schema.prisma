  @@map("book_issues")
}

// ─────────────────────────────────────────────────────────────
// 5.12 Communication
// ─────────────────────────────────────────────────────────────

model message_templates {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String   @db.VarChar(150)
  channel        String   @db.VarChar(20)
  subject        String?  @db.VarChar(255)
  body           String   @db.Text
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id])
  messages    messages[]

  @@map("message_templates")
}

model messages {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String    @db.Uuid
  template_id    String?   @db.Uuid
  channel        String    @db.VarChar(20)
  subject        String?   @db.VarChar(255)
  body           String    @db.Text
  recipient_group String?  @db.VarChar(50)
  sent_by        String    @db.Uuid
  status         String    @default("draft") @db.VarChar(20)
  scheduled_at   DateTime? @db.Timestamptz
  sent_at        DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  institution institutions       @relation(fields: [institution_id], references: [id])
  template    message_templates? @relation(fields: [template_id], references: [id])
  sender      users              @relation(fields: [sent_by], references: [id])
  recipients  message_recipients[]

  @@map("messages")
}

model message_recipients {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id      String    @db.Uuid
  recipient_type  String    @db.VarChar(20)
  recipient_id    String    @db.Uuid
  phone_or_email  String    @db.VarChar(255)
  delivery_status String    @default("pending") @db.VarChar(20)
  delivered_at    DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz

  message messages @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@map("message_recipients")
}

// ─────────────────────────────────────────────────────────────
// 5.13 Documents & Templates
// ─────────────────────────────────────────────────────────────

model document_templates {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  type           String   @db.VarChar(30)
  name           String   @db.VarChar(150)
  config         Json     @default("{}") @db.JsonB
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  institution institutions      @relation(fields: [institution_id], references: [id])
  documents   generated_documents[]

  @@map("document_templates")
}

model generated_documents {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String  @db.Uuid
  template_id   String?  @db.Uuid
  entity_type   String   @db.VarChar(30)
  entity_id     String   @db.Uuid
  document_type String   @db.VarChar(30)
  file_id       String   @db.Uuid
  generated_by  String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz

  institution institutions      @relation(fields: [institution_id], references: [id])
  template    document_templates? @relation(fields: [template_id], references: [id])
  file        file_uploads       @relation(fields: [file_id], references: [id])
  generator   users              @relation(fields: [generated_by], references: [id])

  @@index([entity_type, entity_id])
  @@index([institution_id])
  @@map("generated_documents")
}

// ─────────────────────────────────────────────────────────────
// 5.14 File Storage
// ─────────────────────────────────────────────────────────────

model file_uploads {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String?  @db.Uuid
  uploaded_by    String   @db.Uuid
  original_name  String   @db.VarChar(255)
  storage_key    String   @db.Text
  bucket         String   @db.VarChar(100)
  mime_type      String   @db.VarChar(100)
  size_bytes     BigInt   @db.BigInt
  entity_type    String?  @db.VarChar(50)
  entity_id      String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz

  institution institutions? @relation(fields: [institution_id], references: [id])
  uploader    users         @relation(fields: [uploaded_by], references: [id])

  admission_enquiry_documents admission_enquiry_documents[]
  generated_documents         generated_documents[]

  @@unique([bucket, storage_key])
  @@map("file_uploads")
}

// ─────────────────────────────────────────────────────────────
// 5.15 Audit Logs & Notifications
// ─────────────────────────────────────────────────────────────

/// Institution-scoped immutable audit trail.
model audit_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  user_id        String   @db.Uuid
  role_name      String   @db.VarChar(100)
  module         String   @db.VarChar(60)
  action         String   @db.VarChar(60)
  entity_type    String?  @db.VarChar(60)
  entity_id      String?  @db.Uuid
  before_state   Json?    @db.JsonB
  after_state    Json?    @db.JsonB
  ip_address     String?  @db.VarChar(45)
  user_agent     String?  @db.Text
  reason         String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id])
  user        users        @relation(fields: [user_id], references: [id])

  @@index([institution_id, created_at])
  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([institution_id, module, action])
  @@map("audit_logs")
}

/// Platform-scoped audit trail (GradGrid internal).
model platform_audit_logs {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  role_name    String   @db.VarChar(100)
  module       String   @db.VarChar(60)
  action       String   @db.VarChar(60)
  entity_type  String?  @db.VarChar(60)
  entity_id    String?  @db.Uuid
  before_state Json?    @db.JsonB
  after_state  Json?    @db.JsonB
  ip_address   String?  @db.VarChar(45)
  user_agent   String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@map("platform_audit_logs")
}

model notifications {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  institution_id String?   @db.Uuid
  type           String    @db.VarChar(50)
  title          String    @db.VarChar(200)
  body           String    @db.Text
  link           String?   @db.VarChar(500)
  is_read        Boolean   @default(false)
  read_at        DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  user        users        @relation(fields: [user_id], references: [id])
  institution institutions? @relation(fields: [institution_id], references: [id])

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}
