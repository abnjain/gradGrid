/// Maps subjects to sections with teacher assignment.
model section_subject_assignments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  section_id     String   @db.Uuid
  subject_id     String   @db.Uuid
  teacher_id     String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id])
  section     sections     @relation(fields: [section_id], references: [id])
  subject     subjects     @relation(fields: [subject_id], references: [id])
  teacher     staff?       @relation(fields: [teacher_id], references: [id])

  @@unique([section_id, subject_id])
  @@map("section_subject_assignments")
}

/// Enrolls a student into a specific section for an academic session.
model student_section_enrollments {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id     String   @db.Uuid
  section_id         String   @db.Uuid
  student_id         String   @db.Uuid
  academic_session_id String  @db.Uuid
  enrolled_at        DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  left_at            DateTime? @db.Date
  created_at         DateTime @default(now()) @db.Timestamptz

  institution      institutions      @relation(fields: [institution_id], references: [id])
  section          sections          @relation(fields: [section_id], references: [id])
  student          students          @relation(fields: [student_id], references: [id])
  academic_session academic_sessions @relation(fields: [academic_session_id], references: [id])

  @@unique([student_id, academic_session_id])
  @@index([section_id])
  @@index([student_id])
  @@map("student_section_enrollments")
}

// ─────────────────────────────────────────────────────────────
// 5.7 Admissions
// ─────────────────────────────────────────────────────────────

model admission_enquiries {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id      String   @db.Uuid
  academic_session_id String   @db.Uuid
  source              String   @default("walk_in") @db.VarChar(20)
  student_first_name  String   @db.VarChar(100)
  student_last_name   String   @db.VarChar(100)
  date_of_birth       DateTime? @db.Date
  applying_for_class  String?  @db.VarChar(50)
  parent_name         String   @db.VarChar(200)
  parent_phone        String   @db.VarChar(20)
  parent_email        String?  @db.VarChar(255)
  status              String   @default("new") @db.VarChar(30)
  assigned_to         String?  @db.Uuid
  converted_student_id String? @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz

  institution           institutions                  @relation(fields: [institution_id], references: [id])
  academic_session      academic_sessions             @relation(fields: [academic_session_id], references: [id])
  assigned_staff        staff?                        @relation(fields: [assigned_to], references: [id])
  converted_student     students?                     @relation(fields: [converted_student_id], references: [id])
  status_logs           admission_enquiry_status_logs[]
  notes                 admission_enquiry_notes[]
  documents             admission_enquiry_documents[]

  @@index([institution_id])
  @@index([institution_id, status])
  @@index([institution_id, source])
  @@map("admission_enquiries")
}

model admission_enquiry_status_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id String   @db.Uuid
  from_status String? @db.VarChar(30)
  to_status   String   @db.VarChar(30)
  changed_by  String   @db.Uuid
  reason      String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz

  enquiry admission_enquiries @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  changed_by_user users @relation(fields: [changed_by], references: [id])

  @@index([enquiry_id])
  @@map("admission_enquiry_status_logs")
}

model admission_enquiry_notes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id String   @db.Uuid
  note       String   @db.Text
  noted_by   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  enquiry admission_enquiries @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  noted_by_user users @relation(fields: [noted_by], references: [id])

  @@index([enquiry_id])
  @@map("admission_enquiry_notes")
}

model admission_enquiry_documents {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id    String   @db.Uuid
  file_id       String   @db.Uuid
  document_type String   @db.VarChar(50)
  uploaded_by   String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz

  enquiry       admission_enquiries @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  file          file_uploads        @relation(fields: [file_id], references: [id])
  uploaded_by_user users            @relation("enquiry_doc_uploaded_by", fields: [uploaded_by], references: [id])

  @@map("admission_enquiry_documents")
}

