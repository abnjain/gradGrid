// ─────────────────────────────────────────────────────────────
// GradGrid — Prisma Schema v1.0
// Cloud-Native Multi-Tenant Education ERP Platform
// Generated from GradGrid_Database_Design.md
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// 5.1 Platform Layer
// ─────────────────────────────────────────────────────────────

/// Top-level entity — a school group / educational trust.
model organizations {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(100)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  address     String?
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  pincode     String?  @db.VarChar(10)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz
  deleted_at  DateTime? @db.Timestamptz

  institutions institutions[]

  @@map("organizations")
}

/// Individual school / campus under an organization.
model institutions {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String   @db.Uuid
  name             String   @db.VarChar(200)
  code             String   @db.VarChar(20)
  email            String?  @db.VarChar(255)
  phone            String?  @db.VarChar(20)
  address          String?
  city             String?  @db.VarChar(100)
  district         String?  @db.VarChar(100)
  state            String?  @db.VarChar(100)
  pincode          String?  @db.VarChar(10)
  logo_file_id     String?  @db.Uuid
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz
  deleted_at       DateTime? @db.Timestamptz

  organization organizations @relation(fields: [organization_id], references: [id])
  academic_sessions academic_sessions[]
  admission_enquiries admission_enquiries[]
  attendance_sessions attendance_sessions[]
  audit_logs audit_logs[]
  books books[]
  classes classes[]
  departments departments[]
  document_templates document_templates[]
  exam_types exam_types[]
  exams exams[]
  fee_discounts fee_discounts[]
  fee_payments fee_payments[]
  fee_structures fee_structures[]
  file_uploads file_uploads[]
  houses houses[]
  library_cards library_cards[]
  message_templates message_templates[]
  messages messages[]
  notifications notifications[]
  parents parents[]
  roles roles[]
  salary_records salary_records[]
  sections sections[]
  staff staff[]
  student_section_enrollments student_section_enrollments[]
  students students[]
  subjects subjects[]
  grade_rules              grade_rules[]
  generated_documents      generated_documents[]
  role_assignments         role_assignments[]
  section_subject_assignments section_subject_assignments[]
  teacher_attendance_records teacher_attendance_records[]
  user_sessions user_sessions[]
  users         users[]

  @@map("institutions")
}

/// Academic year / term boundary.
model academic_sessions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id  String   @db.Uuid
  name            String   @db.VarChar(100)
  start_date      DateTime @db.Date
  end_date        DateTime @db.Date
  is_current      Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id])
  admission_enquiries admission_enquiries[]
  attendance_sessions attendance_sessions[]
  classes classes[]
  exams exams[]
  fee_structures fee_structures[]
  fee_payments fee_payments[]
  salary_records salary_records[]
  student_fee_assignments student_fee_assignments[]
  student_section_enrollments student_section_enrollments[]
  students students[]

  @@index([institution_id])
  @@map("academic_sessions")
}

// ─────────────────────────────────────────────────────────────
// 5.2 Identity & Authentication
// ─────────────────────────────────────────────────────────────

/// Platform or institution user account.
model users {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id  String?  @db.Uuid
  first_name      String   @db.VarChar(100)
  last_name       String   @db.VarChar(100)
  email           String   @unique @db.VarChar(255)
  email_verified  Boolean  @default(false)
  phone           String?  @db.VarChar(20)
  is_active       Boolean  @default(true)
  user_type       String   @default("institution") @db.VarChar(20) // platform | institution
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz

  institution              institutions?        @relation(fields: [institution_id], references: [id])
  user_passwords           user_passwords[]
  refresh_tokens           refresh_tokens[]
  user_sessions            user_sessions[]
  email_verifications      email_verifications[]
  password_resets          password_resets[]
  role_assignments         role_assignments[]
  audit_logs               audit_logs[]
  platform_audit_logs      platform_audit_logs[]
  notifications            notifications[]
  generated_documents      generated_documents[]
  file_uploads             file_uploads[]
  fee_payments             fee_payments[]
  salary_records           salary_records[]
  book_issues              book_issues[]
  messages                 messages[]
  admission_enquiry_notes  admission_enquiry_notes[]
  admission_enquiry_status_logs admission_enquiry_status_logs[]
  marks_entered            marks[]
  role_assignments_assigned role_assignments[] @relation("role_assigned_by")
  student_fee_discounts    student_fee_discounts[]
  staff                    staff[]
  // authored enquiry docs
  enquiry_docs_uploaded    admission_enquiry_documents[] @relation("enquiry_doc_uploaded_by")
  // marked attendance
  attendance_sessions      attendance_sessions[]
  teacher_attendance_records_created teacher_attendance_records[] @relation("teacher_attendance_marked_by")
  signup_requests_reviewed   institution_signup_requests[] @relation("signup_reviewer")
  signup_requests_created  institution_signup_requests[] @relation("signup_created_user")

  @@index([institution_id])
  @@map("users")
}

/// Password hash for a user (separated for security).
model user_passwords {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  password_hash String  @db.Text
  is_current   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("user_passwords")
}

/// JWT refresh token store (rotating).
model refresh_tokens {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  token_hash    String   @db.Text
  family_id     String   @db.Uuid
  device_info   String?  @db.Text
  ip_address    String?  @db.VarChar(45)
  expires_at    DateTime @db.Timestamptz
  is_revoked    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

/// Active user sessions.
model user_sessions {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  institution_id String?  @db.Uuid
  refresh_token_id String? @db.Uuid
  device_info    String?  @db.Text
  ip_address     String?  @db.VarChar(45)
  is_active      Boolean  @default(true)
  last_active_at DateTime @default(now()) @db.Timestamptz
  logged_out_at  DateTime? @db.Timestamptz
  created_at     DateTime @default(now()) @db.Timestamptz

  user        users       @relation(fields: [user_id], references: [id])
  institution institutions? @relation(fields: [institution_id], references: [id])

  @@index([user_id])
  @@index([refresh_token_id])
  @@map("user_sessions")
}

/// Email verification tokens.
model email_verifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.Text
  expires_at DateTime @db.Timestamptz
  is_used    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("email_verifications")
}

/// Password reset tokens.
model password_resets {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.Text
  expires_at DateTime @db.Timestamptz
  is_used    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("password_resets")
}

/// Self-service institution signup applications (pending admin approval).
model institution_signup_requests {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status            String    @default("pending") @db.VarChar(20)
  organization_name String    @db.VarChar(200)
  institution_name  String    @db.VarChar(200)
  institution_code  String    @db.VarChar(20)
  city              String?   @db.VarChar(100)
  state             String?   @db.VarChar(100)
  first_name        String    @db.VarChar(100)
  last_name         String    @db.VarChar(100)
  email             String    @db.VarChar(255)
  phone             String?   @db.VarChar(20)
  password_hash     String    @db.Text
  email_verified    Boolean   @default(false)
  otp_hash          String?   @db.Text
  otp_expires_at    DateTime? @db.Timestamptz
  reviewed_by       String?   @db.Uuid
  reviewed_at       DateTime? @db.Timestamptz
  rejection_reason  String?   @db.Text
  created_user_id   String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz

  reviewer     users? @relation("signup_reviewer", fields: [reviewed_by], references: [id])
  created_user users? @relation("signup_created_user", fields: [created_user_id], references: [id])

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([institution_code])
  @@map("institution_signup_requests")
}

// ─────────────────────────────────────────────────────────────
// 5.3 RBAC & Permission Registry
// ─────────────────────────────────────────────────────────────

/// System-defined and institution-custom roles.
model roles {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String?  @db.Uuid // NULL = platform role
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  is_system_role Boolean  @default(false)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  institution      institutions?     @relation(fields: [institution_id], references: [id])
  role_permissions role_permissions[]
  role_assignments role_assignments[]

  @@unique([institution_id, name])
  @@index([institution_id])
  @@map("roles")
}

/// The authoritative catalog of every permission key.
model permission_registry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String   @db.VarChar(60)
  action      String   @db.VarChar(60)
  key         String   @unique @db.VarChar(120)
  description String   @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz

  role_permissions role_permissions[]

  @@map("permission_registry")
}

/// Junction: role → permission.
model role_permissions {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       roles               @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission permission_registry @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("role_permissions")
}

/// Associates a user with a role, scoped to an institution (null = platform).
model role_assignments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  role_id        String   @db.Uuid
  institution_id String?  @db.Uuid
  assigned_by    String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  user        users @relation(fields: [user_id], references: [id])
  role        roles @relation(fields: [role_id], references: [id])
  institution institutions? @relation(fields: [institution_id], references: [id])
  assigned_by_user users @relation("role_assigned_by", fields: [assigned_by], references: [id])

  @@unique([user_id, role_id, institution_id])
  @@index([user_id])
  @@index([institution_id])
  @@map("role_assignments")
}

// ─────────────────────────────────────────────────────────────
// 5.4 People — Students
// ─────────────────────────────────────────────────────────────

model students {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id      String   @db.Uuid
  academic_session_id String   @db.Uuid
  // Identity
  first_name          String   @db.VarChar(100)
  last_name           String   @db.VarChar(100)
  date_of_birth       DateTime? @db.Date
  gender              String?  @db.VarChar(10)
  blood_group         String?  @db.VarChar(5)
  religion            String?  @db.VarChar(50)
  caste               String?  @db.VarChar(50)
  category            String?  @db.VarChar(30)
  handicapped         Boolean  @default(false)
  photo_file_id       String?  @db.Uuid
  // Enrollment identifiers
  admission_number    String   @db.VarChar(50)
  enrollment_number   String?  @db.VarChar(50)
  scholar_number      String?  @db.VarChar(50)
  roll_number         String?  @db.VarChar(20)
  student_type        String?  @db.VarChar(20)
  date_of_admission   DateTime? @db.Date
  // Academic placement
  class_id            String?  @db.Uuid
  section_id          String?  @db.Uuid
  stream              String?  @db.VarChar(50)
  medium              String?  @db.VarChar(30)
  house_id            String?  @db.Uuid
  route               String?  @db.VarChar(100)
  stoppage_landmark   String?  @db.VarChar(200)
  // Contact
  phone               String?  @db.VarChar(20)
  alternate_phone     String?  @db.VarChar(20)
  email               String?  @db.VarChar(255)
  // Address
  address             String?  @db.Text
  city                String?  @db.VarChar(100)
  district            String?  @db.VarChar(100)
  state               String?  @db.VarChar(100)
  pincode             String?  @db.VarChar(10)
  // Previous school
  prev_school_name    String?  @db.VarChar(255)
  prev_school_city    String?  @db.VarChar(100)
  last_class          String?  @db.VarChar(50)
  last_result         String?  @db.VarChar(20)
  // Encrypted sensitive fields
  aadhaar_number_enc   String? @db.Text
  aadhaar_number_iv    String? @db.Text
  samagra_child_id_enc String? @db.Text
  samagra_child_id_iv  String? @db.Text
  samagra_family_id_enc String? @db.Text
  samagra_family_id_iv  String? @db.Text
  apaar_id_enc         String? @db.Text
  apaar_id_iv          String? @db.Text
  // RTE
  is_rte              Boolean @default(false)
  // Bank details
  bank_name           String? @db.VarChar(100)
  bank_account_enc    String? @db.Text
  bank_account_iv     String? @db.Text
  bank_ifsc           String? @db.VarChar(20)
  account_holder_name String? @db.VarChar(150)
  scholarship_name    String? @db.VarChar(200)
  admitted_class      String? @db.VarChar(50)
  // Status
  status              String  @default("active") @db.VarChar(20)
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz

  institution      institutions      @relation(fields: [institution_id], references: [id])
  academic_session academic_sessions @relation(fields: [academic_session_id], references: [id])

  student_parent_links            student_parent_links[]
  student_section_enrollments     student_section_enrollments[]
  student_attendance_records      student_attendance_records[]
  marks                           marks[]
  student_fee_assignments         student_fee_assignments[]
  student_fee_discounts           student_fee_discounts[]
  fee_payments                    fee_payments[]
  admission_enquiries             admission_enquiries[]
  library_cards                   library_cards[]

  @@unique([institution_id, admission_number])
  @@index([institution_id])
  @@index([academic_session_id])
  @@index([institution_id, status])
  @@index([institution_id, last_name, first_name])
  @@index([institution_id, category])
  @@index([institution_id, is_rte])
  @@map("students")
}

/// Parent or guardian records.
model parents {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id      String   @db.Uuid
  first_name          String   @db.VarChar(100)
  last_name           String   @db.VarChar(100)
  relation            String   @db.VarChar(30)
  date_of_birth       DateTime? @db.Date
  qualification       String?  @db.VarChar(100)
  occupation          String?  @db.VarChar(100)
  phone               String   @db.VarChar(20)
  alternate_phone     String?  @db.VarChar(20)
  email               String?  @db.VarChar(255)
  address             String?  @db.Text
  spouse_name         String?  @db.VarChar(200)
  spouse_dob          DateTime? @db.Date
  spouse_qualification String? @db.VarChar(100)
  spouse_occupation   String?  @db.VarChar(100)
  spouse_phone        String?  @db.VarChar(20)
  date_of_anniversary DateTime? @db.Date
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz

  institution          institutions          @relation(fields: [institution_id], references: [id])
  student_parent_links student_parent_links[]

  @@map("parents")
}

/// Many-to-many between students and parents.
model student_parent_links {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id String  @db.Uuid
  parent_id  String  @db.Uuid
  is_primary Boolean @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  student students @relation(fields: [student_id], references: [id])
  parent  parents  @relation(fields: [parent_id], references: [id])

  @@unique([student_id, parent_id])
  @@map("student_parent_links")
}

// ─────────────────────────────────────────────────────────────
// 5.5 People — Staff & Teachers
// ─────────────────────────────────────────────────────────────

model staff {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id      String   @db.Uuid
  user_id             String?  @db.Uuid
  department_id       String?  @db.Uuid
  employee_code       String?  @db.VarChar(50)
  first_name          String   @db.VarChar(100)
  last_name           String   @db.VarChar(100)
  date_of_birth       DateTime? @db.Date
  gender              String?  @db.VarChar(10)
  phone               String   @db.VarChar(20)
  email               String   @db.VarChar(255)
  address             String?  @db.Text
  city                String?  @db.VarChar(100)
  state               String?  @db.VarChar(100)
  pincode             String?  @db.VarChar(10)
  designation         String?  @db.VarChar(100)
  qualification       String?  @db.Text
  experience_years    Int?     @db.Integer
  photo_file_id       String?  @db.Uuid
  // Encrypted sensitive fields
  aadhaar_number_enc  String?  @db.Text
  aadhaar_number_iv   String?  @db.Text
  pan_number_enc      String?  @db.Text
  pan_number_iv       String?  @db.Text
  driving_licence_enc String?  @db.Text
  driving_licence_iv  String?  @db.Text
  bank_account_enc    String?  @db.Text
  bank_account_iv     String?  @db.Text
  bank_ifsc           String?  @db.VarChar(20)
  bank_name           String?  @db.VarChar(100)
  // Employment
  employment_status   String   @default("active") @db.VarChar(20)
  joining_date        DateTime? @db.Date
  leaving_date        DateTime? @db.Date
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id])
  user           users?       @relation(fields: [user_id], references: [id])
  department     departments? @relation(fields: [department_id], references: [id])

  salary_records            salary_records[]
  teacher_attendance_records teacher_attendance_records[]
  sections_as_class_teacher  sections[]                   @relation("class_teacher")
  section_subject_assignments section_subject_assignments[]
  admission_enquiries        admission_enquiries[]
  library_cards              library_cards[]
  // dept head
  department_head            departments[]                @relation("department_head")

  @@index([institution_id])
  @@index([user_id])
  @@index([department_id])
  @@index([institution_id, employment_status])
  @@map("staff")
}

// ─────────────────────────────────────────────────────────────
// 5.6 Academic Structure
// ─────────────────────────────────────────────────────────────

model departments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  head_staff_id  String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  institution      institutions @relation(fields: [institution_id], references: [id])
  head_staff       staff?       @relation("department_head", fields: [head_staff_id], references: [id])
  staff_members    staff[]
  subjects         subjects[]

  @@unique([institution_id, name])
  @@map("departments")
}

model houses {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String   @db.VarChar(100)
  color          String?  @db.VarChar(7)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id])

  @@unique([institution_id, name])
  @@map("houses")
}

model classes {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id     String   @db.Uuid
  academic_session_id String  @db.Uuid
  name               String   @db.VarChar(50)
  sort_order         Int      @default(0) @db.Integer
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @default(now()) @db.Timestamptz
  deleted_at         DateTime? @db.Timestamptz

  institution      institutions      @relation(fields: [institution_id], references: [id])
  academic_session academic_sessions @relation(fields: [academic_session_id], references: [id])
  sections         sections[]
  exam_subjects    exam_subjects[]
  fee_structures   fee_structures[]

  @@unique([institution_id, academic_session_id, name])
  @@map("classes")
}

model sections {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id  String   @db.Uuid
  class_id        String   @db.Uuid
  name            String   @db.VarChar(20)
  class_teacher_id String? @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id])
  class       classes      @relation(fields: [class_id], references: [id])
  class_teacher staff?     @relation("class_teacher", fields: [class_teacher_id], references: [id])

  section_subject_assignments  section_subject_assignments[]
  student_section_enrollments  student_section_enrollments[]
  attendance_sessions          attendance_sessions[]

  @@unique([class_id, name])
  @@map("sections")
}

model subjects {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  department_id  String?  @db.Uuid
  name           String   @db.VarChar(100)
  code           String?  @db.VarChar(20)
  type           String   @default("theory") @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id])
  department  departments? @relation(fields: [department_id], references: [id])

  section_subject_assignments section_subject_assignments[]
  exam_subjects               exam_subjects[]

