# GradGrid — Render manual environment variables
#
# render.yaml auto-wires DATABASE_URL, secrets, CORS, and service URLs.
# Only add these in the Render Dashboard if you need them.

# ── Optional: transactional email (gradgrid-api service) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GradGrid <no-reply@gradgrid.app>

# ── Optional: override seed admin email (gradgrid-api, for prisma db seed) ──
# SEED_PLATFORM_ADMIN_EMAIL=admin@gradgrid.app
# SEED_PLATFORM_ADMIN_PASSWORD=Admin@12345
