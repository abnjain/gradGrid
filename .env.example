# ─────────────────────────────────────────────────────
# GradGrid — Docker Compose / Production Environment
# Copy to .env and replace all secrets before deploying.
# ─────────────────────────────────────────────────────

# ── Public URLs ─────────────────────────────────────
SITE_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=/api/v1

# Caddy bind address (:80 for HTTP, or your.domain.com for auto-TLS)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=gradgrid

# ── API (backend) ───────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
RUN_MIGRATIONS=true

# Generated automatically in compose from POSTGRES_* — override only if using external DB
# DATABASE_URL=postgresql://postgres:password@postgres:5432/gradgrid?schema=public

ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars-long
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars-long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

ENCRYPTION_KEY=change-me-32-byte-encryption-key-hex-value
MASTER_ENCRYPTION_KEY=change-me-master-encryption-key-hex-value

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=gradgrid:

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=GradGrid <no-reply@your-verified-domain.com>

LOG_LEVEL=info

# ── Optional seed (run once on first deploy via compose exec) ──
# cd backend && npm run prisma:seed
