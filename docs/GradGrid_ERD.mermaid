%% RELATIONSHIPS
%% ═══════════════════════════════════════════════

    ORGANIZATIONS ||--o{ INSTITUTIONS : "has"
    INSTITUTIONS ||--o{ ACADEMIC_SESSIONS : "has"
    INSTITUTIONS ||--o{ USERS : "has"
    INSTITUTIONS ||--o{ STUDENTS : "has"
    INSTITUTIONS ||--o{ PARENTS : "has"
    INSTITUTIONS ||--o{ STAFF : "has"
    INSTITUTIONS ||--o{ DEPARTMENTS : "has"
    INSTITUTIONS ||--o{ HOUSES : "has"
    INSTITUTIONS ||--o{ CLASSES : "has"
    INSTITUTIONS ||--o{ SUBJECTS : "has"
    INSTITUTIONS ||--o{ ROLES : "defines custom"
    INSTITUTIONS ||--o{ ADMISSION_ENQUIRIES : "receives"
    INSTITUTIONS ||--o{ ATTENDANCE_SESSIONS : "tracks"
    INSTITUTIONS ||--o{ EXAMS : "conducts"
    INSTITUTIONS ||--o{ FEE_STRUCTURES : "defines"
    INSTITUTIONS ||--o{ FEE_PAYMENTS : "records"
    INSTITUTIONS ||--o{ SALARY_RECORDS : "manages"
