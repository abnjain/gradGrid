    SECTIONS ||--o{ STUDENT_SECTION_ENROLLMENTS : "enrolls"
    SECTIONS ||--o{ ATTENDANCE_SESSIONS : "tracks"
    SUBJECTS ||--o{ SECTION_SUBJECT_ASSIGNMENTS : "assigned to"
    STAFF ||--o{ SECTION_SUBJECT_ASSIGNMENTS : "teaches"
    STAFF ||--o{ DEPARTMENTS : "heads"
    DEPARTMENTS ||--o{ STAFF : "has"
    DEPARTMENTS ||--o{ SUBJECTS : "owns"

    STUDENTS ||--o{ STUDENT_PARENT_LINKS : "linked"
    PARENTS ||--o{ STUDENT_PARENT_LINKS : "linked"
    STUDENTS ||--o{ STUDENT_SECTION_ENROLLMENTS : "enrolled in"
    STUDENTS ||--o{ STUDENT_ATTENDANCE_RECORDS : "tracked"
    STUDENTS ||--o{ MARKS : "receives"
    STUDENTS ||--o{ STUDENT_FEE_ASSIGNMENTS : "assigned"
    STUDENTS ||--o{ STUDENT_FEE_DISCOUNTS : "receives"
    STUDENTS ||--o{ FEE_PAYMENTS : "makes"
    STUDENTS ||--o{ LIBRARY_CARDS : "holds"

    STAFF ||--o{ TEACHER_ATTENDANCE_RECORDS : "tracked"
    STAFF ||--o{ SALARY_RECORDS : "receives"
    STAFF ||--o{ LIBRARY_CARDS : "holds"
    STAFF ||--o{ ATTENDANCE_SESSIONS : "marks"

    ADMISSION_ENQUIRIES ||--o{ ADMISSION_ENQUIRY_STATUS_LOGS : "tracks transitions"
    ADMISSION_ENQUIRIES ||--o{ ADMISSION_ENQUIRY_NOTES : "has"
    ADMISSION_ENQUIRIES ||--o{ ADMISSION_ENQUIRY_DOCUMENTS : "has"
    ADMISSION_ENQUIRIES }o--o| STUDENTS : "converts to"

    ATTENDANCE_SESSIONS ||--o{ STUDENT_ATTENDANCE_RECORDS : "contains"

