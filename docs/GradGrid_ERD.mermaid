    ACADEMIC_SESSIONS ||--o{ CLASSES : "has"
    ACADEMIC_SESSIONS ||--o{ STUDENTS : "enrolls"
    ACADEMIC_SESSIONS ||--o{ STUDENT_SECTION_ENROLLMENTS : "tracks"
    ACADEMIC_SESSIONS ||--o{ EXAMS : "contains"
    ACADEMIC_SESSIONS ||--o{ FEE_STRUCTURES : "defines"

    CLASSES ||--o{ SECTIONS : "divided into"
